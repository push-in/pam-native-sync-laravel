{
  "name":"pushinbr/pam-native-sync-laravel",
  "description":"Independent Laravel server implementation of the PAM synchronization wire protocol.",
  "type":"library","license":"Apache-2.0",
  "require":{"php":"^8.5","illuminate/contracts":"^12.0|^13.0","illuminate/database":"^12.0|^13.0","illuminate/http":"^12.0|^13.0","illuminate/routing":"^12.0|^13.0","illuminate/support":"^12.0|^13.0"},
  "require-dev":{
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5.50|^12.5.8|^13.0"
